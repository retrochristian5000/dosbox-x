#!/usr/bin/env bash

# Interactive editor for the universal DOSBox-X build entry point.
# The saved file is data only; ./build validates it instead of sourcing it.

set -u

root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
cd "$root" || exit 1
config_file="$root/.dosbox-x-build.conf"

profile=auto
sdl=auto
macos_universal=0
compiler=system

warn() { printf 'menuconfig: %s\n' "$*" >&2; }

valid_profile() {
    case "$1" in auto|unix|macos|mingw|emscripten|riscos|hx-dos|build-*) return 0 ;; *) return 1 ;; esac
}

load_config() {
    [ -f "$config_file" ] || return 0
    local key value
    while IFS='=' read -r key value || [ -n "${key:-}" ]; do
        case "$key" in
            ''|'#'*) continue ;;
            profile)
                if valid_profile "$value"; then profile="$value"; else warn "ignoring invalid profile '$value'"; fi
                ;;
            sdl)
                case "$value" in auto|1|2) sdl="$value" ;; *) warn "ignoring invalid SDL value '$value'" ;; esac
                ;;
            macos_universal)
                case "$value" in 0|1) macos_universal="$value" ;; *) warn "ignoring invalid macos_universal value '$value'" ;; esac
                ;;
            toolchain)
                case "$value" in system|llvm) compiler="$value" ;; *) warn "ignoring invalid toolchain value '$value'" ;; esac
                ;;
            *) warn "ignoring unknown key '$key'" ;;
        esac
    done < "$config_file"
}

sdl_name() {
    case "$sdl" in auto) printf 'auto' ;; 1) printf 'SDL1' ;; 2) printf 'SDL2' ;; esac
}

universal_name() {
    [ "$macos_universal" -eq 1 ] && printf 'yes' || printf 'no'
}

toolchain_name() {
    case "$compiler" in
        system) printf 'system compiler' ;;
        llvm) printf 'pinned WHP LLVM' ;;
    esac
}

choose_toolchain() {
    local reply
    printf '\nCompiler toolchain (current: %s)\n  1) system compiler\n  2) pinned WHP LLVM\nSelect (Enter keeps current): ' "$(toolchain_name)"
    IFS= read -r reply
    case "$reply" in
        1) compiler=system ;;
        2) compiler=llvm ;;
    esac
}

choose_profile() {
    local choices=(auto unix macos mingw emscripten riscos hx-dos)
    local f reply i=1
    for f in "$root"/build-*; do
        [ -f "$f" ] && choices+=("$(basename -- "$f")")
    done

    printf '\nBuild profile/backend (current: %s)\n' "$profile"
    for f in "${choices[@]}"; do
        printf ' %2d) %s\n' "$i" "$f"
        i=$((i + 1))
    done
    printf 'Select (Enter keeps current): '
    IFS= read -r reply
    case "$reply" in ''|*[!0-9]*) return ;; esac
    if [ "$reply" -ge 1 ] 2>/dev/null && [ "$reply" -le "${#choices[@]}" ]; then
        profile="${choices[$((reply - 1))]}"
    fi
}

choose_sdl() {
    local reply
    printf '\nSDL version (current: %s)\n  1) auto\n  2) SDL1\n  3) SDL2\nSelect (Enter keeps current): ' "$(sdl_name)"
    IFS= read -r reply
    case "$reply" in 1) sdl=auto ;; 2) sdl=1 ;; 3) sdl=2 ;; esac
}

build_preview_command() {
    preview=(bash "$root/build" --no-config --dry-run --profile "$profile")
    case "$sdl" in 1) preview+=(--sdl1) ;; 2) preview+=(--sdl2) ;; esac
    if [ "$macos_universal" -eq 1 ]; then
        preview+=(--universal)
    else
        preview+=(--no-universal)
    fi
    case "$compiler" in
        system) preview+=(--system-compiler) ;;
        llvm) preview+=(--llvm) ;;
    esac
}

preview_config() {
    local output
    build_preview_command
    if output="$("${preview[@]}" 2>&1)"; then
        printf '\n%s\n' "$output"
        return 0
    fi
    printf '\n%s\n' "$output" >&2
    return 1
}

save_config() {
    local tmp
    preview_config || { warn 'configuration was not saved'; return 1; }
    tmp="${config_file}.tmp.$$"
    {
        printf '# Generated by ./build menuconfig\n'
        printf 'profile=%s\n' "$profile"
        printf 'sdl=%s\n' "$sdl"
        printf 'macos_universal=%s\n' "$macos_universal"
        printf 'toolchain=%s\n' "$compiler"
    } > "$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$config_file" || { rm -f "$tmp"; return 1; }
    printf 'Saved %s\n' "$config_file"
}

reset_config() {
    profile=auto
    sdl=auto
    macos_universal=0
    compiler=system
}

[ -t 0 ] && [ -t 1 ] || { warn 'an interactive terminal is required'; exit 2; }
load_config

while :; do
    printf '\nDOSBox-X build configuration\n'
    printf '  profile/backend:  %s\n' "$profile"
    printf '  SDL:              %s\n' "$(sdl_name)"
    printf '  macOS universal:  %s\n' "$(universal_name)"
    printf '  compiler:         %s\n' "$(toolchain_name)"
    printf '\n'
    printf '  1) Build profile/backend\n'
    printf '  2) SDL version\n'
    printf '  3) Toggle macOS universal\n'
    printf '  4) Compiler toolchain\n'
    printf '  5) Preview resolved build\n'
    printf '  6) Save and exit\n'
    printf '  7) Reset to defaults\n'
    printf '  8) Exit without saving\n'
    printf 'Select: '
    IFS= read -r choice
    case "$choice" in
        1) choose_profile ;;
        2) choose_sdl ;;
        3) [ "$macos_universal" -eq 1 ] && macos_universal=0 || macos_universal=1 ;;
        4) choose_toolchain ;;
        5) preview_config || true ;;
        6) save_config && exit 0 ;;
        7) reset_config ;;
        8) exit 0 ;;
    esac
done
