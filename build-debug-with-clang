#!/usr/bin/env bash
set -e

root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CC="${CC:-$(command -v clang)}"
CXX="${CXX:-$(command -v clang++)}"
export CC CXX
if command -v clang-cpp >/dev/null 2>&1; then
    CPP="${CPP:-$(command -v clang-cpp)}"
    export CPP
fi
exec bash "$root/build-debug" "$@"
