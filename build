#!/usr/bin/env bash

# One entry point for the existing DOSBox-X build scripts.
# Platform-specific build logic stays in the build-* backends.

set -u

root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
cd "$root" || exit 1
config_file="$root/.dosbox-x-build.conf"

fail() { printf 'build: %s\n' "$*" >&2; exit 2; }

help() {
    cat <<'EOF_HELP'
Usage: ./build [options] [profile] [backend arguments...]
       ./build menuconfig

Options:
  -h, --help          Show this help
  -l, --list          List build backends
  -n, --dry-run       Show the selected backend without running it
  -p, --profile NAME  Select a backend/profile
      --universal     Request a macOS universal build
      --no-universal  Disable a configured macOS universal build
      --no-config     Ignore .dosbox-x-build.conf
      --show-config   Show the effective saved settings
      --llvm          Build with the pinned WHP LLVM toolchain
      --system-compiler
                      Use the host compiler (default)

Profiles: auto (default), unix, macos, mingw, emscripten,
or an SDL2 build-* backend shown by --list.

Examples:
  ./build menuconfig
  ./build
  ./build
  ./build --llvm
  ./build llvm-bootstrap
  ./build macos --universal
  ./build build-debug-g3-sdl2
  ./build mingw -- --disable-avcodec
EOF_HELP
}

list() {
    printf '%s\n' 'Profiles: auto unix macos mingw emscripten' '' 'SDL2 backends:'
    local f name
    for f in "$root"/build-*; do
        [ -f "$f" ] || continue
        name="$(basename -- "$f")"
        case "$name" in
            *sdl2*) printf '%s\n' "$name" ;;
        esac
    done | LC_ALL=C sort
}

map_profile() {
    case "$1" in
        auto)       printf '%s\n' auto ;;
        unix)       printf '%s\n' build-sdl2 ;;
        macos)      printf '%s\n' build-macos-sdl2 ;;
        mingw)      printf '%s\n' build-mingw-sdl2 ;;
        emscripten) printf '%s\n' build-emscripten-sdl2 ;;
        build-*sdl2*) printf '%s\n' "$1" ;;
        *)          return 1 ;;
    esac
}

auto_backend() {
    case "$(uname -s 2>/dev/null)" in
        Darwin)                                  printf '%s\n' build-macos-sdl2 ;;
        MINGW*|MSYS*|CYGWIN*)                    printf '%s\n' build-mingw-sdl2 ;;
        Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|SunOS)
                                                printf '%s\n' build-sdl2 ;;
        *) fail "unknown host; use --profile or a build-* backend" ;;
    esac
}

load_config() {
    [ -f "$config_file" ] || return 0
    local key value
    while IFS='=' read -r key value || [ -n "${key:-}" ]; do
        case "$key" in
            ''|'#'*) continue ;;
            profile)
                map_profile "$value" >/dev/null || fail "invalid profile in $config_file: $value"
                profile="$value"
                ;;
            sdl)
                case "$value" in
                    auto|2) : ;; # accepted for compatibility with older saved configs
                    1) fail "SDL1 was retired; run ./build menuconfig and save a new configuration" ;;
                    *) fail "invalid legacy SDL value in $config_file: $value" ;;
                esac
                ;;
            macos_universal)
                case "$value" in 0|1) macos_universal="$value" ;; *) fail "invalid macos_universal value in $config_file: $value" ;; esac
                ;;
            toolchain)
                case "$value" in system|llvm) compiler="$value" ;; *) fail "invalid toolchain value in $config_file: $value" ;; esac
                ;;
            *) fail "unknown key in $config_file: $key" ;;
        esac
    done < "$config_file"
}

show_config() {
    printf 'Config file: %s\n' "$config_file"
    if [ -f "$config_file" ]; then
        printf 'profile=%s\nmacos_universal=%s\ntoolchain=%s\n' "$profile" "$macos_universal" "$compiler"
    else
        printf '(not created; built-in defaults are active)\n'
        printf 'profile=%s\nmacos_universal=%s\ntoolchain=%s\n' "$profile" "$macos_universal" "$compiler"
    fi
}

case "${1:-}" in
    menuconfig|--menuconfig) exec bash "$root/menuconfig" ;;
    llvm-bootstrap|--llvm-bootstrap) exec bash "$root/scripts/bootstrap-native-llvm.bash" ;;
esac

profile=auto
profile_set=0
macos_universal=0
compiler=system
dry=0
show_saved=0
args=()
use_config=1

for arg in "$@"; do
    [ "$arg" = --no-config ] && use_config=0
done
[ "$use_config" -eq 1 ] && load_config

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help|help) help; exit 0 ;;
        -l|--list|list) list; exit 0 ;;
        -n|--dry-run) dry=1; shift ;;
        --universal) macos_universal=1; shift ;;
        --no-universal) macos_universal=0; shift ;;
        --no-config) shift ;;
        --show-config) show_saved=1; shift ;;
        --llvm) compiler=llvm; shift ;;
        --system-compiler) compiler=system; shift ;;
        -p|--profile)
            [ "$#" -ge 2 ] || fail "$1 needs a name"
            profile="$2"; profile_set=1; shift 2 ;;
        --profile=*)
            profile="${1#*=}"; [ -n "$profile" ] || fail '--profile needs a name'
            profile_set=1; shift ;;
        --) shift; args+=("$@"); break ;;
        *)
            if [ "$profile_set" -eq 0 ] && map_profile "$1" >/dev/null 2>&1; then
                profile="$1"; profile_set=1; shift
            else
                args+=("$@"); break
            fi
            ;;
    esac
done

[ "$show_saved" -eq 1 ] && { show_config; [ "$dry" -eq 0 ] && exit 0; }

backend="$(map_profile "$profile")" || fail "unknown profile '$profile'"
[ "$backend" = auto ] && { backend="$(auto_backend)" || exit $?; }
[ -f "$root/$backend" ] || fail "backend '$backend' does not exist"

if [ "$macos_universal" -eq 1 ]; then
    case "$backend" in
        build-macos-sdl2)
            have_universal=0
            for arg in "${args[@]}"; do
                [ "$arg" = universal ] && have_universal=1
            done
            [ "$have_universal" -eq 1 ] || args=(universal "${args[@]}")
            ;;
    esac
fi

if [ "$compiler" = llvm ]; then
    case "$backend" in
        build-mingw*|build-emscripten*|build-os2*)
            fail "the pinned native LLVM toolchain is not wired to backend '$backend'"
            ;;
    esac
    [ "${args[0]:-}" != 32 ] || fail "the pinned native LLVM path does not currently support the legacy 32-bit shortcut"
fi

printf 'DOSBox-X build backend: %s\n' "$backend"
printf 'DOSBox-X compiler: %s\n' "$compiler"
if [ "$dry" -eq 1 ]; then
    printf 'Command:'; printf ' %q' "$backend" "${args[@]}"; printf '\n'
    exit 0
fi

if [ "$compiler" = llvm ]; then
    llvm_dir="$(bash "$root/scripts/bootstrap-native-llvm.bash")" || exit $?
    [ -x "$llvm_dir/bin/clang" ] && [ -x "$llvm_dir/bin/clang++" ] ||
        fail "LLVM bootstrap did not provide clang/clang++: $llvm_dir"
    CC="$llvm_dir/bin/clang"
    CXX="$llvm_dir/bin/clang++"
    export CC CXX
    [ ! -x "$llvm_dir/bin/clang-cpp" ] || { CPP="$llvm_dir/bin/clang-cpp"; export CPP; }
    AR="$llvm_dir/bin/llvm-ar"
    RANLIB="$llvm_dir/bin/llvm-ranlib"
    NM="$llvm_dir/bin/llvm-nm"
    STRIP="$llvm_dir/bin/llvm-strip"
    OBJCOPY="$llvm_dir/bin/llvm-objcopy"
    OBJDUMP="$llvm_dir/bin/llvm-objdump"
    export AR RANLIB NM STRIP OBJCOPY OBJDUMP
fi

case "$backend" in
    *.cmd|*.bat)
        command -v cmd.exe >/dev/null 2>&1 || fail "'$backend' requires cmd.exe"
        exec cmd.exe /d /c "$backend" "${args[@]}"
        ;;
    *) exec bash "$root/$backend" "${args[@]}" ;;
esac
