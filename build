#!/usr/bin/env bash

# One entry point for the existing DOSBox-X build scripts.
# Platform-specific build logic stays in the build-* backends.

set -u

root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
cd "$root" || exit 1
config_file="$root/.dosbox-x-build.conf"

fail() { printf 'build: %s\n' "$*" >&2; exit 2; }

WHP_SOURCE_UPDATE=${WHP_SOURCE_UPDATE:-auto}
WHP_SUBMODULES=${WHP_SUBMODULES:-auto}

case "$WHP_SOURCE_UPDATE" in
    auto|0|1) ;;
    *) fail "WHP_SOURCE_UPDATE must be auto, 0, or 1" ;;
esac
case "$WHP_SUBMODULES" in
    auto|0|1) ;;
    *) fail "WHP_SUBMODULES must be auto, 0, or 1" ;;
esac
export WHP_SOURCE_UPDATE WHP_SUBMODULES

source_update_skip=0
if [ "$WHP_SOURCE_UPDATE" = auto ]; then
    case "${1:-}" in
        -h|--help|help|-l|--list|list|menuconfig|--menuconfig)
            source_update_skip=1
            ;;
    esac
    for update_arg in "$@"; do
        case "$update_arg" in
            -n|--dry-run|--show-config)
                source_update_skip=1
                ;;
        esac
    done
    unset update_arg
fi

if [ "${WHP_SOURCE_UPDATE_DONE:-0}" != 1 ] &&
   [ "$WHP_SOURCE_UPDATE" != 0 ] &&
   [ "$source_update_skip" != 1 ]; then
    source_revision_before=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
    WHP_SOURCE_UPDATE="$WHP_SOURCE_UPDATE" \
        /bin/sh "$root/scripts/update-source.sh" || exit $?
    source_revision_after=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)

    WHP_SOURCE_UPDATE_DONE=1
    export WHP_SOURCE_UPDATE_DONE

    if [ -n "$source_revision_before" ] &&
       [ -n "$source_revision_after" ] &&
       [ "$source_revision_before" != "$source_revision_after" ]; then
        printf 'DOSBox-X source update: re-entering updated build (%s -> %s)\n' \
            "$source_revision_before" "$source_revision_after" >&2
        exec "$root/build" "$@"
    fi
    unset source_revision_before source_revision_after
fi
unset source_update_skip

help() {
    cat <<'EOF_HELP'
Usage: ./build [options] [profile] [backend arguments...]
       ./build menuconfig

Options:
  -h, --help          Show this help
  -l, --list          List build backends
  -n, --dry-run       Show the selected backend without running it
  -p, --profile NAME  Select a backend/profile
      --universal     Request a macOS universal build
      --no-universal  Disable a configured macOS universal build
      --clean          Force a clean macOS rebuild
      --reconfigure    Re-run macOS configure without discarding compatible objects
      --no-config     Ignore .dosbox-x-build.conf
      --show-config   Show the effective saved settings
      --llvm          Build with the pinned WHP LLVM toolchain
      --system-compiler
                      Use the host compiler (default)

Profiles: auto (default), unix, macos, mingw, emscripten,
or an SDL2 build-* backend shown by --list.

Environment:
  WHP_SOURCE_UPDATE=auto|0|1
                      Refresh the configured parent branch before a real build
  WHP_SUBMODULES=auto|0|1
                      Materialize only pinned submodules needed by the build

Examples:
  ./build menuconfig
  ./build
  ./build --llvm
  ./build llvm-bootstrap
  ./build macos --universal
  ./build build-debug-g3
  ./build mingw -- --disable-avcodec
EOF_HELP
}

list() {
    printf '%s\n' 'Profiles: auto unix macos mingw emscripten' '' 'SDL2 backends:'
    local f name
    for f in "$root"/build-*; do
        [ -f "$f" ] || continue
        name="$(basename -- "$f")"
        case "$name" in
            build-mingw-lowend9x|build-mingw-hx-dos|build-riscos|build-macosold) continue ;;
            *) printf '%s\n' "$name" ;;
        esac
    done | LC_ALL=C sort
}

map_profile() {
    case "$1" in
        auto)       printf '%s\n' auto ;;
        unix)       printf '%s\n' build-unix ;;
        macos)      printf '%s\n' build-macos ;;
        mingw)      printf '%s\n' build-mingw ;;
        emscripten) printf '%s\n' build-emscripten-sdl2 ;;
        build-mingw-lowend9x|build-mingw-hx-dos|build-riscos|build-macosold) return 1 ;;
        build-*)    printf '%s\n' "$1" ;;
        *)          return 1 ;;
    esac
}

auto_backend() {
    case "$(uname -s 2>/dev/null)" in
        Darwin)                                  printf '%s\n' build-macos ;;
        MINGW*|MSYS*|CYGWIN*)                    printf '%s\n' build-mingw ;;
        Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|SunOS)
                                                printf '%s\n' build-unix ;;
        *) fail "unknown host; use --profile or a build-* backend" ;;
    esac
}

load_config() {
    [ -f "$config_file" ] || return 0
    local key value
    while IFS='=' read -r key value || [ -n "${key:-}" ]; do
        case "$key" in
            ''|'#'*) continue ;;
            profile)
                map_profile "$value" >/dev/null || fail "invalid profile in $config_file: $value"
                profile="$value"
                ;;
            sdl)
                case "$value" in
                    auto|2) : ;; # accepted for compatibility with older saved configs
                    1) fail "SDL1 was retired; run ./build menuconfig and save a new configuration" ;;
                    *) fail "invalid legacy SDL value in $config_file: $value" ;;
                esac
                ;;
            macos_universal)
                case "$value" in 0|1) macos_universal="$value" ;; *) fail "invalid macos_universal value in $config_file: $value" ;; esac
                ;;
            toolchain)
                case "$value" in system|llvm) compiler="$value" ;; *) fail "invalid toolchain value in $config_file: $value" ;; esac
                ;;
            *) fail "unknown key in $config_file: $key" ;;
        esac
    done < "$config_file"
}

show_config() {
    printf 'Config file: %s\n' "$config_file"
    if [ -f "$config_file" ]; then
        printf 'profile=%s\nmacos_universal=%s\ntoolchain=%s\n' "$profile" "$macos_universal" "$compiler"
    else
        printf '(not created; built-in defaults are active)\n'
        printf 'profile=%s\nmacos_universal=%s\ntoolchain=%s\n' "$profile" "$macos_universal" "$compiler"
    fi
}

case "${1:-}" in
    menuconfig|--menuconfig)
        exec bash "$root/menuconfig"
        ;;
    llvm-bootstrap|--llvm-bootstrap)
        if [ "$WHP_SUBMODULES" != 0 ]; then
            WHP_SUBMODULES="$WHP_SUBMODULES" \
                /bin/sh "$root/scripts/update-submodules.sh" toolchains/llvm-project || exit $?
        fi
        exec bash "$root/scripts/bootstrap-native-llvm.bash"
        ;;
esac

profile=auto
profile_set=0
macos_universal=0
compiler=system
clean_build=0
force_reconfigure=0
dry=0
show_saved=0
args=()
use_config=1

for arg in "$@"; do
    [ "$arg" = --no-config ] && use_config=0
done
[ "$use_config" -eq 1 ] && load_config

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help|help) help; exit 0 ;;
        -l|--list|list) list; exit 0 ;;
        -n|--dry-run) dry=1; shift ;;
        --universal) macos_universal=1; shift ;;
        --no-universal) macos_universal=0; shift ;;
        --clean) clean_build=1; shift ;;
        --reconfigure) force_reconfigure=1; shift ;;
        --no-config) shift ;;
        --show-config) show_saved=1; shift ;;
        --llvm) compiler=llvm; shift ;;
        --system-compiler) compiler=system; shift ;;
        -p|--profile)
            [ "$#" -ge 2 ] || fail "$1 needs a name"
            profile="$2"; profile_set=1; shift 2 ;;
        --profile=*)
            profile="${1#*=}"; [ -n "$profile" ] || fail '--profile needs a name'
            profile_set=1; shift ;;
        --) shift; args+=("$@"); break ;;
        *)
            if [ "$profile_set" -eq 0 ] && map_profile "$1" >/dev/null 2>&1; then
                profile="$1"; profile_set=1; shift
            else
                args+=("$@"); break
            fi
            ;;
    esac
done

[ "$show_saved" -eq 1 ] && { show_config; [ "$dry" -eq 0 ] && exit 0; }

backend="$(map_profile "$profile")" || fail "unknown profile '$profile'"
[ "$backend" = auto ] && { backend="$(auto_backend)" || exit $?; }
[ -f "$root/$backend" ] || fail "backend '$backend' does not exist"

if [ "$clean_build" -eq 1 ] || [ "$force_reconfigure" -eq 1 ]; then
    case "$backend" in
        build-macos|build-macos-sdl2) ;;
        *) fail "--clean/--reconfigure are currently supported by the macOS backends" ;;
    esac
fi

if [ "$macos_universal" -eq 1 ]; then
    case "$backend" in
        build-macos)
            have_universal=0
            for arg in "${args[@]}"; do
                [ "$arg" = universal ] && have_universal=1
            done
            [ "$have_universal" -eq 1 ] || args=(universal "${args[@]}")
            ;;
    esac
fi

if [ "$compiler" = llvm ]; then
    case "$backend" in
        build-mingw*|build-emscripten*|build-os2*)
            fail "the pinned native LLVM toolchain is not wired to backend '$backend'"
            ;;
    esac
    [ "${args[0]:-}" != 32 ] || fail "the pinned native LLVM path does not currently support the legacy 32-bit shortcut"
fi

printf 'DOSBox-X build backend: %s\n' "$backend"
printf 'DOSBox-X compiler: %s\n' "$compiler"
[ "$clean_build" -eq 0 ] || printf 'DOSBox-X macOS clean rebuild: yes\n'
[ "$force_reconfigure" -eq 0 ] || printf 'DOSBox-X macOS reconfigure: yes\n'
if [ "$dry" -eq 1 ]; then
    printf 'Command:'; printf ' %q' "$backend" "${args[@]}"; printf '\n'
    exit 0
fi

submodule_paths=()
case "$backend" in
    build-macos|build-macos-sdl2)
        submodule_paths+=(vs/zlib)
        ;;
esac
if [ "$compiler" = llvm ]; then
    submodule_paths+=(toolchains/llvm-project)
fi
if [ "$WHP_SUBMODULES" != 0 ] && [ "${#submodule_paths[@]}" -gt 0 ]; then
    WHP_SUBMODULES="$WHP_SUBMODULES" \
        /bin/sh "$root/scripts/update-submodules.sh" "${submodule_paths[@]}" || exit $?
fi
unset submodule_paths

if [ "$clean_build" -eq 1 ]; then
    export DOSBOX_CLEAN_BUILD=1
fi
if [ "$force_reconfigure" -eq 1 ]; then
    export DOSBOX_RECONFIGURE=1
fi

if [ "$compiler" = llvm ]; then
    llvm_dir="$(bash "$root/scripts/bootstrap-native-llvm.bash")" || exit $?
    [ -x "$llvm_dir/bin/clang" ] && [ -x "$llvm_dir/bin/clang++" ] ||
        fail "LLVM bootstrap did not provide clang/clang++: $llvm_dir"
    CC="$llvm_dir/bin/clang"
    CXX="$llvm_dir/bin/clang++"
    export CC CXX
    [ ! -x "$llvm_dir/bin/clang-cpp" ] || { CPP="$llvm_dir/bin/clang-cpp"; export CPP; }
    AR="$llvm_dir/bin/llvm-ar"
    RANLIB="$llvm_dir/bin/llvm-ranlib"
    NM="$llvm_dir/bin/llvm-nm"
    STRIP="$llvm_dir/bin/llvm-strip"
    OBJCOPY="$llvm_dir/bin/llvm-objcopy"
    OBJDUMP="$llvm_dir/bin/llvm-objdump"
    export AR RANLIB NM STRIP OBJCOPY OBJDUMP
fi

case "$backend" in
    *.cmd|*.bat)
        command -v cmd.exe >/dev/null 2>&1 || fail "'$backend' requires cmd.exe"
        exec cmd.exe /d /c "$backend" "${args[@]}"
        ;;
    *) exec bash "$root/$backend" "${args[@]}" ;;
esac
